# dreamap-frontend ortam değişkenleri.
# Bu dosya şablondur; gerçek değerler Vercel > Project Settings > Environment
# Variables'ta tutulur, yerelde .env.local'a yazılır (.env.local git'e GİRMEZ).

# --- Supabase (zorunlu) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Uygulama (zorunlu) ---
NEXT_PUBLIC_APP_URL=

# --- Vercel Cron (vercel.json'daki 4 cron'u korur; boşsa uçlar korumasız kalır) ---
CRON_SECRET=

# --- Admin uçları ---
ADMIN_TOKEN=
ADMIN_REANALYZE_TOKEN=

# --- AI sağlayıcıları (kullanılan akışa göre) ---
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_KEY=
GEMINI_FREE_KEY=
GROQ_API_KEY=
GROQ_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
REPLICATE_API_TOKEN=
NVIDIA_NIM_API_KEY=
CEREBRAS_API_KEY=
HUGGINGFACE_API_KEY=
GITHUB_MODELS_TOKEN=

# --- Çeviri ---
TRANSLATION_PROVIDER=
DEEPL_API_KEY=

# --- Medya ---
PIXABAY_API_KEY=

# --- Web Push (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Firebase / Android push ---
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Google Play (abonelik doğrulama) ---
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=

# --- Gumroad ---
GUMROAD_WEBHOOK_SECRET=
GUMROAD_PREMIUM_PRODUCT_ID=
GUMROAD_SINGLE_PRODUCT_ID=
